# Dependencies — restored from the lockfile, never committed (3.9 MB here).
node_modules/

# Secrets. Nothing in this repo needs them today, but an .env is the usual
# place a deploy key ends up, and it should never be the thing you notice
# after pushing.
.env
.env.*
!.env.example

# Logs and crash reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Build and test scratch
coverage/
*.tmp
